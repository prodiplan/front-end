# Frontend Environment Variables - Development

# API Configuration
# API Gateway running on Docker at port 4000
# Use http://localhost:4000 for development (Docker)
# Use https://prodiplan.my.id for production (Cloudflare Tunnel)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase (optional - backend handles auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Config
NEXT_PUBLIC_APP_ENVIRONMENT=development
