# Frontend Environment Variables

# API Configuration - Backend service base URL
# Development: http://localhost:4000 (API Gateway via Docker)
# Production: https://api.prodiplan.my.id (API Gateway)
NEXT_PUBLIC_API_URL=https://api.prodiplan.my.id

# Optional: Firebase Configuration (for client-side features if needed)
# Leave empty jika backend will handle all Firebase auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Application Configuration
NEXT_PUBLIC_APP_NAME=ProdiPlan
NEXT_PUBLIC_APP_ENVIRONMENT=development
